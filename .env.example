LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
JUDGE_MODEL=llama3.2:3b
EMBED_MODEL=all-minilm
EMBED_DIM=384

THINKING=off
MAX_STEPS=3
NUM_CTX=4096

TOP_K=4 # top [number] relevant document chunks
MIN_TOP_SCORE=0.35
CHUNK_TOKENS=300
CHUNK_OVERLAP=50

# Host-run Python uses localhost; Compose overrides this for its container:
OLLAMA_BASE_URL=http://localhost:11434